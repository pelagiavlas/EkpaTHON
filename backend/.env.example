# Αντιγράψτε το σε backend/.env και αλλάξτε ό,τι χρειάζεται. Το .env δεν ανεβαίνει στο git.

# mock (προεπιλογή): έτοιμο περιεχόμενο από JSON + απλοί κανόνες, χωρίς internet.
# llm: για όταν συμπληρωθεί το app/content/llm.py.
CONTENT_PROVIDER=mock

# Μόνο για CONTENT_PROVIDER=llm. Ποτέ στο frontend, ποτέ στο git.
# ANTHROPIC_API_KEY=

# Για να ανοίγει η εφαρμογή από κινητό στο ίδιο Wi-Fi:
# STUDYBUDDY_HOST=0.0.0.0

# Παρουσίαση: δείχνει την «Προεπισκόπηση για την παρουσίαση» (εναλλακτικά ?demo=1 στο URL).
# DEMO_MODE=true

# Μαθήματα ΕΚΠΑ: mock (προεπιλογή, προσομοιωμένο eClass) ή eclass (όταν συμπληρωθεί το app/ekpa/eclass.py).
# EKPA_PROVIDER=mock
# Ρολόι demo (προαιρετικά): συγκεκριμένη μέρα/ώρα αντί για «η κοντινότερη μέρα με μάθημα στις 11:00».
# DEMO_DATE=2026-12-01
# DEMO_TIME=09:30
